{
  "name": "spa-rtc",
  "version": "1.0.1",
  "description": "Peer-to-peer multiplayer for static browser games on spa-hub: WebRTC transports, rooms with late join and rejoin, and a netcode kit (prediction, interpolation, delta snapshots, lag compensation).",
  "engines": {
    "node": ">=22.8"
  },
  "exports": {
    "./*": "./src/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "./node_modules/.bin/eslint .",
    "test:unit": "node --test \"test/**/*.test.js\"",
    "pretest:coverage": "node -e \"require('fs').mkdirSync('coverage', {recursive: true})\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.js\"",
    "test": "npm run lint && npm run test:unit"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^10.0.0"
  }
}
